{
  "name": "game",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm --workspace @game/mobile start",
    "web": "npm --workspace @game/mobile run web",
    "server": "npm --workspace @game/server run dev",
    "validation:awn": "python scripts/download-awn.py",
    "validation:awn:classify": "python scripts/classify-awn.py",
    "validation:awn:expand": "python scripts/classify-awn-expanded.py",
    "validation:awn:review": "python scripts/classify-awn-review.py",
    "validation:merge-review": "python scripts/merge-awn-review.py",
    "validation:build-index": "python scripts/build-validation-index.py",
    "validation:wikidata": "python scripts/import-wikidata.py",
    "validation:omw": "python scripts/import-omw.py",
    "validation:omw:classify": "python scripts/classify-omw.py",
    "validation:merge": "python scripts/merge-validation-sources.py",
    "validation:wordlist": "python scripts/import-arabic-wordlist.py",
    "validation:elner": "python scripts/import-elner-candidates.py",
    "validation:merge-elner": "python scripts/merge-elner-candidates.py"
  }
}
